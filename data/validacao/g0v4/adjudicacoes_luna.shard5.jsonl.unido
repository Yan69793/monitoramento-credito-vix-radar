{"id": "i0135", "classe": "nao_evento", "tipo": null, "data_evento": null, "protocolo": "1133299", "trecho": "Uma vez declaradas vencidas antecipadamente as Debêntures", "origem_protocolo": null, "origem_data": null, "posicao_correta": "B", "confianca": "alta", "justificativa": "A escritura descreve efeitos condicionais de um eventual vencimento antecipado, sem registrar que ele tenha sido declarado ou ocorrido. O documento anterior também trata de condições hipotéticas, não de vencimento consumado.", "adjudicador": "codex:gpt-6-luna", "trecho_confere": true, "adjudicado_em": "2026-10-18T05:59:09+00:00"}
