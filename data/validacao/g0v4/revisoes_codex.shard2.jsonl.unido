{"id": "i0790", "classe": "nao_evento", "tipo": null, "data_evento": null, "protocolo": "1354036", "trecho": "aprovaram, a autorização prévia para exclusão do vencimento antecipado relativo ao Índice 7 Financeiro", "origem_protocolo": null, "origem_data": null, "confianca": "alta", "justificativa": "A assembleia aprovou repactuação e exclusão de vencimento antecipado por índice financeiro, sem evidência fornecida de inadimplemento pecuniário, insuficiência de caixa, vencimento antecipado declarado ou pedido de RJ, RE ou mediação. A hipótese é financeira, não pecuniária, e sua exclusão não constitui evento próprio nos critérios do guia.", "revisor": "codex:gpt-6-luna", "trecho_confere": true, "revisado_em": "2026-10-18T05:52:16+00:00"}
