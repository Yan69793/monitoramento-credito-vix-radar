{"id": "i0126", "classe": "evento_proprio", "tipo": "vencimento antecipado", "data_evento": "2013-04-29", "protocolo": "377860", "trecho": "acerca da decretação de vencimento antecipado das Debêntures", "origem_protocolo": null, "origem_data": null, "confianca": "alta", "justificativa": "A assembleia de debenturistas delibera sobre a decretação do vencimento antecipado das debêntures da Companhia. O trecho fornecido não informa se a deliberação foi aprovada, mas identifica o ato consumado de declarar o vencimento.", "revisor": "codex:gpt-6-luna", "trecho_confere": true, "revisado_em": "2026-10-18T05:50:04+00:00"}
