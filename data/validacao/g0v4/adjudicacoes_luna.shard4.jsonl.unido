{"id": "i0415", "classe": "evento_terceiro", "tipo": null, "data_evento": null, "protocolo": "774295", "trecho": "sua coligada, Renova Energia S.A. (“Renova”) divulgou, nesta data, o seguinte Fato Relevante", "origem_protocolo": null, "origem_data": null, "posicao_correta": "B", "confianca": "alta", "justificativa": "O documento identifica a Renova como coligada da Cemig e atribui à Renova o protocolo dos planos de recuperação judicial. O ato não é da companhia do CNPJ candidato.", "adjudicador": "codex:gpt-6-luna", "trecho_confere": true, "adjudicado_em": "2026-10-18T06:00:19+00:00"}
