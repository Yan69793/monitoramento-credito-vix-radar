{"id": "i0685", "classe": "continuacao", "tipo": "RJ", "data_evento": null, "protocolo": "524833", "trecho": "foi aprovada a ratificação do pedido de recuperação judicial da Companhia, promovido em conjunto com as suas subsidiárias integrais", "origem_protocolo": "521308", "origem_data": "2016-06-20", "confianca": "alta", "justificativa": "A assembleia ratifica pedido de recuperação judicial já ajuizado, e o documento anterior identifica o pedido e sua data de entrega. A ratificação não abre processo distinto.", "revisor": "codex:gpt-6-luna", "trecho_confere": true, "revisado_em": "2026-10-18T05:52:03+00:00"}
