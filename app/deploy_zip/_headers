# _headers — Cloudflare Pages
# Instrui o navegador a SEMPRE verificar se há versão nova antes de usar o cache.
# Resultado: nenhum usuário precisa apertar Ctrl+F5 ou limpar cache manualmente.

# ─── JS do app (CACHEJS1 v202.3) ───
# Sempre revalidar JS. Sem o no-cache, o Pages default max-age=14400 permite
# que o navegador sirva modulo truncado do cache por ate 4h sem perguntar.
# Os imports relativos dos ES modules nao passam por query param, entao
# o ?v= no HTML nao alcanca. Unica saida e forcar o navegador a revalidar.
# Padroes duplicados (com/sem /) como defesa contra divergencia de parser.
/app/js/*
  Cache-Control: no-cache, must-revalidate
/app/js*
  Cache-Control: no-cache, must-revalidate
app/js/*
  Cache-Control: no-cache, must-revalidate

/admin/*
  Cache-Control: no-cache, must-revalidate
/admin*
  Cache-Control: no-cache, must-revalidate
admin/*
  Cache-Control: no-cache, must-revalidate

# ─── Headers de segurança ───
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

/index.html
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0

/version.json
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0

/api/*
  Cache-Control: no-store, no-cache
  Pragma: no-cache
